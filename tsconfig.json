{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // baseUrl non e' opzionale con `paths`: senza, next/jest trasforma
    // l'alias `@/*` in un percorso RELATIVO rispetto alla root che Next
    // inferisce (che, con un package-lock.json anche in `~`, finisce fuori
    // dal progetto) e produce richieste tipo "../../../../../src/lib/..." che
    // non esistono: "Cannot find module". Con baseUrl esplicito l'alias
    // torna a essere un path assoluto.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "test-env.ts", "test-genkit.ts", "*.mjs", "scripts", "example_scraper"]
}
