rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function isDeveloper() {
      return getRole() == 'developer';
    }

    function isDirectorOrAbove() {
      return getRole() in ['director', 'developer'];
    }

    function isCoachOrAbove() {
      return getRole() in ['coach', 'director', 'developer'];
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function incomingIsAuthorized(seasonId) {
      return isSignedIn() && (
        request.resource.data.teamOwnerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/teams/$(seasonId)).data.sharedWith ||
        get(/databases/$(database)/documents/teams/$(seasonId)).data.ownerId == request.auth.uid
      );
    }

    function existingIsAuthorized(seasonId) {
      return isSignedIn() && (
        resource.data.teamOwnerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/teams/$(seasonId)).data.sharedWith ||
        get(/databases/$(database)/documents/teams/$(seasonId)).data.ownerId == request.auth.uid
      );
    }
    
    function isSeasonAuthorized(seasonId) {
      let season = get(/databases/$(database)/documents/teams/$(seasonId)).data;
      return isSignedIn() && (season.ownerId == request.auth.uid || request.auth.uid in season.sharedWith);
    }

    // ─── /users/{userId} ─────────────────────────────────────────────────────
    
    match /users/{userId} {
      allow get:    if isOwner(userId) || isDeveloper();
      allow list:   if isDeveloper();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isDeveloper());
      allow delete: if isExistingOwner(userId) || isDeveloper();

      match /scoutPlayers/{scoutPlayerId} {
        allow get, list: if isOwner(userId);
        allow create:    if isOwner(userId) && request.resource.data.id == scoutPlayerId;
        allow update:    if isOwner(userId);
        allow delete:    if isOwner(userId);
      }

      match /scoutCategories/{scoutCategoryId} {
        allow get, list: if isOwner(userId);
        allow create:    if isOwner(userId) && request.resource.data.id == scoutCategoryId;
        allow update:    if isOwner(userId);
        allow delete:    if isOwner(userId);
      }

      match /trainingSessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create:    if isOwner(userId);
        allow update, delete: if isExistingOwner(userId);

        match /attendance/{playerId} {
          allow get, list: if isOwner(userId);
          allow write:     if isOwner(userId);
        }
      }

      // ─── Stagione attiva per utente ──────────────────────────────────────
      //
      // `isActive` non puo' stare sul documento della stagione: quel documento
      // e' condiviso, quindi il flag sarebbe condiviso e due allenatori si
      // pesterebbero i piedi. La scelta della stagione attiva e' per utente e
      // vive qui. Non contiene dati della squadra: solo quale stagione hai
      // scelto di guardare in questo momento.
      match /settings/{settingId} {
        allow get, create, update, delete: if isOwner(userId);
      }

      // ─── Physical Tests ───────────────────────────────────────────────────
      match /physicalTests/{testId} {
        allow get, list: if isOwner(userId);
        allow create:    if isOwner(userId) && request.resource.data.userId == userId;
        allow update:    if isExistingOwner(userId);
        allow delete:    if isExistingOwner(userId);
      }
    }

    // ─── /teams/{seasonId} ───────────────────────────────────────────────────
    
    match /teams/{seasonId} {
      // ─── Accesso con codice di invito ───────────────────────────────────────
      //
      // Il join con codice ("Partecipa con codice") ha bisogno di DUE cose
      // che prima non erano permesse, ed e' per questo che falliva con
      // "Missing or insufficient permissions.":
      //
      // 1. LEGGERE il documento per verificare che il codice esista. La regola
      //    precedente permetteva la lettura solo a owner e a chi era gia' in
      //    sharedWith: chi sta per entrare non e' in nessuno dei due, quindi
      //    la getDoc veniva negata e il flusso moriva sul primo passo.
      //
      // 2. SCRIVERE per aggiungersi. La regola precedente permetteva
      //    l'update a un non-proprietario solo se il documento in arrivo
      //    conteneva gia' il suo uid in sharedWith — cioe' se era gia' dentro.
      //    Richiedere di essere gia' dentro per poter entrare e' circolare, e
      //    nessuna variante della stessa regola lo risolve: serve una via
      //    d'ingresso che non passi da "l'ho gia' letto".
      //
      // La barriera di sicurezza e' il codice: `S-` + 5 caratteri base36
      // casuali (~60 milioni di combinazioni). Chi e' autenticato e conosce il
      // codice puo' entrare: e' il comportamento atteso della funzione.
      // I documenti figli (players, matches, sessions, ...) restano protetti
      // da isSeasonAuthorized, quindi NON diventano leggibili solo per aver
      // letto il documento della stagione: si ottiene l'accesso scrivendo il
      // proprio uid in sharedWith, che e' l'unico modo per ottenerlo.
      allow get:    if isSignedIn();
      allow list:   if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.sharedWith);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
                      (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid) ||
                      // Aggiungersi a se' stessi con il codice di invito.
                      // hasOnly(['sharedWith','updatedAt']) perche' joinSeason
                      // scrive anche updatedAt: hasOnly(['sharedWith']) lo
                      // renderebbe DENIED per un campo extra.
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith', 'updatedAt']) &&
                       request.auth.uid in request.resource.data.sharedWith &&
                       // Non si puo' aggiungere qualcun altro al posto proprio:
                       // l'array deve conservare tutti gli uid precedenti e
                       // crescere di ESATTAMENTE un elemento.
                       // (La concatenazione di liste con '+' non e' valida in
                       // Firestore rules — il compilatore la segnala come
                       // "Invalid type ... Expected one of [list, set]".
                       // hasAll + size e' l'equivalente corretto.)
                       request.resource.data.sharedWith.hasAll(resource.data.sharedWith) &&
                       request.resource.data.sharedWith.size() == resource.data.sharedWith.size() + 1
                      )
                    );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /players/{playerId} {
        allow get:    if isSignedIn() && (resource == null || isSeasonAuthorized(seasonId));
        allow list:   if isSignedIn() && isSeasonAuthorized(seasonId);
        allow create: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow update: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);
      }

      match /matches/{matchId} {
        allow get:    if isSignedIn() && (resource == null || isSeasonAuthorized(seasonId));
        allow list:   if isSignedIn() && isSeasonAuthorized(seasonId);
        allow create: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow update: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);

        match /lineup/{lineupId} {
          allow get:    if isSignedIn() && (resource == null || isSeasonAuthorized(seasonId));
          allow list:   if isSignedIn() && isSeasonAuthorized(seasonId);
          allow create: if isSignedIn() && isSeasonAuthorized(seasonId);
          allow update: if isSignedIn() && isSeasonAuthorized(seasonId);
          allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);
        }

        match /events/{eventId} {
          allow get:    if isSignedIn() && (resource == null || isSeasonAuthorized(seasonId));
          allow list:   if isSignedIn() && isSeasonAuthorized(seasonId);
          allow create: if isSignedIn() && isSeasonAuthorized(seasonId);
          allow update: if isSignedIn() && isSeasonAuthorized(seasonId);
          allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);
        }

        match /stats/{statId} {
          allow get:    if isSignedIn() && (resource == null || isSeasonAuthorized(seasonId));
          allow list:   if isSignedIn() && isSeasonAuthorized(seasonId);
          allow create: if isSignedIn() && isSeasonAuthorized(seasonId);
          allow update: if isSignedIn() && isSeasonAuthorized(seasonId);
          allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);
        }
      }

      match /sessions/{sessionId} {
        allow get:    if isSignedIn() && (resource == null || isSeasonAuthorized(seasonId));
        allow list:   if isSignedIn() && isSeasonAuthorized(seasonId);
        allow create: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow update: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);
      }

      match /events/{eventId} {
        allow get:    if isSignedIn() && (resource == null || isSeasonAuthorized(seasonId));
        allow list:   if isSignedIn() && isSeasonAuthorized(seasonId);
        allow create: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow update: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);
      }

      match /trainings/{trainingId} {
        allow get:    if isSignedIn() && (resource == null || isSeasonAuthorized(seasonId));
        allow list:   if isSignedIn() && isSeasonAuthorized(seasonId);
        allow create: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow update: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);
      }

      // ─── Allenamenti (2026-09: spostati da users/{uid}/trainingSessions) ──
      //
      // Erano gli UNICI dati sotto users/{uid}: privati per costruzione, quindi
      // un ospite della stagione vedeva la stagione vuota. Convivono con
      // players e matches sotto teams/{seasonId}, e la condivisione funziona
      // perche' isSeasonAuthorized autorizza owner e membri di sharedWith.
      match /sessions/{sessionId} {
        allow get:    if isSignedIn() && isSeasonAuthorized(seasonId);
        allow list:   if isSignedIn() && isSeasonAuthorized(seasonId);
        allow create: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow update: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);

        // Presenze della sessione: un documento per giocatore.
        match /attendance/{playerId} {
          allow get:    if isSignedIn() && isSeasonAuthorized(seasonId);
          allow list:   if isSignedIn() && isSeasonAuthorized(seasonId);
          allow create: if isSignedIn() && isSeasonAuthorized(seasonId);
          allow update: if isSignedIn() && isSeasonAuthorized(seasonId);
          allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);
        }
      }

      // ─── Test fisici (2026-09: spostati da users/{uid}/physicalTests) ────
      //
      // Come gli allenamenti, erano gli unici dati sotto users/{uid} e quindi
      // privati. Stessa logica delle sessions: isSeasonAuthorized autorizza
      // il proprietario e chi e' in sharedWith.
      match /physicalTests/{testId} {
        allow get:    if isSignedIn() && isSeasonAuthorized(seasonId);
        allow list:   if isSignedIn() && isSeasonAuthorized(seasonId);
        allow create: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow update: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);
      }

      match /aggregates/{aggregateId=**} {
        allow get, list: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow write:    if isSignedIn() && isSeasonAuthorized(seasonId);
      }

      // ─── Presence: chi e' online su questa stagione (2026-09) ────────────
      //
      // Ogni utente scrive il proprio documento in
      // teams/{seasonId}/presence/{uid} con un battito periodico. Un
      // onSnapshot su questa collezione dice chi c'e' SENZA refresh, e fa
      // comparire l'avviso "un altro allenatore e' su questa stagione,
      // le modifiche possono sovrascriversi".
      //
      // Il documento contiene SOLO lastSeen: nessun dato della squadra, e le
      // regole lo impongono con hasOnly, cosi' nessuno puo' nascondere altro
      // dentro. Nota sul delete: e' consentito a chiunque della stagione
      // perche' serve a ripulire i documenti scaduti, e un documento di
      // presenza non contiene nulla di riservato.
      match /presence/{uid} {
        allow get, list: if isSignedIn() && isSeasonAuthorized(seasonId);
        allow create: if isSignedIn() && isSeasonAuthorized(seasonId) && request.resource.data.keys().hasOnly(['lastSeen']);
        allow update: if isSignedIn() && isSeasonAuthorized(seasonId) && request.resource.data.keys().hasOnly(['lastSeen']);
        allow delete: if isSignedIn() && isSeasonAuthorized(seasonId);
      }
    }

    // ─── /exercises/{exerciseId} ─────────────────────────────────────────────
    
    match /exercises/{exerciseId} {
      allow get, list: if isSignedIn() && (resource.data.visibility == 'global' || resource.data.userId == request.auth.uid);
      allow create:    if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // ─── /settings/{userId} ──────────────────────────────────────────────────
    
    match /settings/{userId} {
      allow get, write: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
