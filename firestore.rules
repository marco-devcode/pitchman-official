rules_version = '2';

// ============================================================================
// Assumed Data Model
// ============================================================================
//
// Custom Claims (set via Firebase Admin SDK):
//   - admin: bool (optional) — legacy/emulator admin flag
//   - role: 'developer' | 'director' | 'coach' | 'player' (optional)
//
// Collection: users/{userId}
//   - uid: string
//   - email: string
//   - displayName: string
//   - role: 'developer' | 'director' | 'coach' | 'player' (protected; only admin/developer can modify)
//   - createdAt, updatedAt: string
//   Subcollections (user-owned legacy & personal settings):
//     - settings/{settingId} (e.g. activeSeason: { seasonId, updatedAt })
//     - scoutPlayers/{scoutPlayerId} (legacy)
//     - scoutCategories/{scoutCategoryId} (legacy)
//     - trainingSessions/{sessionId} + attendance/{playerId} (legacy)
//     - physicalTests/{testId} (legacy)
//
// Collection: teams/{seasonId} (created/deleted via Admin SDK API routes only)
//   - id, userId, ownerId: string (immutable from client)
//   - name: string (1..100 chars; editable by season owner only)
//   - updatedAt: string (1..64 chars; editable by season owner only)
//   - members: map<uid, 'owner' | 'staff'> (server-managed)
//   - memberUids: list<uid> (server-managed)
//   - sharedWith: list<uid> (legacy, server-managed)
//   - directorUids: list<uid> (server-managed, read-only directors)
//   - plan, limits, playerCount, isActive, createdAt (server-managed / legacy)
//   Subcollections:
//     - players/{playerId}              (read: member | season director; write: member)
//     - scouts/{scoutId}                (read: member | season director; create: member with teamOwnerId == uid; update/delete: member)
//     - scoutCategories/{categoryId}    (read: member | season director; write: member)
//     - matches/{matchId}               (read/write: member only)
//       - lineup/{lineupId}             (read/write: member only)
//       - events/{eventId}              (read/write: member only)
//       - stats/{statId}                (read/write: member only)
//     - sessions/{sessionId}            (read/write: member only)
//       - attendance/{playerId}         (read/write: member only)
//     - events/{eventId}                (legacy; read/write: member only)
//     - trainings/{trainingId}          (legacy; read/write: member only)
//     - physicalTests/{testId}          (read/write: member only)
//     - aggregates/{aggregateId=**}     (read/write: member only)
//     - presence/{uid}                  (read/delete: member; create/update: self member with only { lastSeen: number|timestamp })
//
// Server-only Collections (no client access):
//   - invites, rateLimits, aiUsage, aiCache, feedback
//
// Collection: exercises/{exerciseId}
//   - userId: string (required on create == request.auth.uid; immutable on update)
//   - visibility: 'global' | 'private'
//
// Collection: settings/{userId}
//   - User preferences owned exclusively by userId
//
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ Helper Functions ══════════════════════════════════════════════════
    //
    // NESSUNA dichiarazione `let` in tutto il file: in Firestore Rules `let`
    // seguito da `if` viene rifiutato dal compilatore (`Unexpected 'if'`).
    // Tutte le helper usano espressioni booleane pure.

    function signedIn() {
      return request.auth != null;
    }

    function isUserOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasAppRole(roleName) {
      return signedIn() &&
        'role' in request.auth.token &&
        request.auth.token.role == roleName;
    }

    function isAdmin() {
      return signedIn() &&
        'admin' in request.auth.token &&
        request.auth.token.admin == true;
    }

    function isDeveloper() {
      return hasAppRole('developer');
    }

    function isAdminOrDeveloper() {
      return isAdmin() || isDeveloper();
    }

    function teamPath(seasonId) {
      return /databases/$(database)/documents/teams/$(seasonId);
    }

    function isTeamDocOwner(data) {
      return signedIn() && (
        ('ownerId' in data && data.ownerId == request.auth.uid) ||
        ('members' in data &&
         data.members is map &&
         request.auth.uid in data.members &&
         data.members[request.auth.uid] == 'owner')
      );
    }

    function isTeamDocMember(data) {
      return signedIn() && (
        ('ownerId' in data && data.ownerId == request.auth.uid) ||
        ('members' in data &&
         data.members is map &&
         request.auth.uid in data.members) ||
        ('memberUids' in data &&
         data.memberUids is list &&
         request.auth.uid in data.memberUids) ||
        ('sharedWith' in data &&
         data.sharedWith is list &&
         request.auth.uid in data.sharedWith)
      );
    }

    function isTeamDocDirector(data) {
      return hasAppRole('director') &&
        'directorUids' in data &&
        data.directorUids is list &&
        request.auth.uid in data.directorUids;
    }

    function isOwnerOf(seasonId) {
      return signedIn() &&
        exists(teamPath(seasonId)) &&
        isTeamDocOwner(get(teamPath(seasonId)).data);
    }

    function isMember(seasonId) {
      return signedIn() &&
        exists(teamPath(seasonId)) &&
        isTeamDocMember(get(teamPath(seasonId)).data);
    }

    // Il direttore sportivo vede i dati di identità/mercato della squadra
    // (rosa, osservati, categorie osservati) in sola lettura, mai i dati di
    // gestione dell'allenatore (partite, eventi, presenze, test fisici).
    function isSeasonDirector(seasonId) {
      return hasAppRole('director') &&
        exists(teamPath(seasonId)) &&
        isTeamDocDirector(get(teamPath(seasonId)).data);
    }

    function isMemberOrDirector(seasonId) {
      return isMember(seasonId) || isSeasonDirector(seasonId);
    }

    function isSeasonDirectorOrAuthorized(seasonId) {
      return isMemberOrDirector(seasonId);
    }

    // ═══ /users/{userId} ═══════════════════════════════════════════════════

    match /users/{userId} {
      allow get:    if isUserOwner(userId) || isAdminOrDeveloper();
      allow list:   if isAdminOrDeveloper();
      allow create: if isAdminOrDeveloper() ||
                      (isUserOwner(userId) &&
                       (!('role' in request.resource.data) ||
                        request.resource.data.role in ['coach', 'player']));
      allow update: if isAdminOrDeveloper() ||
                      (isUserOwner(userId) &&
                       resource != null &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if (isUserOwner(userId) && resource != null) || isAdminOrDeveloper();

      // Preferenze utente attive (es. `users/{uid}/settings/activeSeason`)
      match /settings/{settingId} {
        allow read, write: if isUserOwner(userId);
      }

      // Dati storici sotto l'utente (mantenuti per cleanup / compatibilità)
      match /scoutPlayers/{scoutPlayerId} {
        allow read, write: if isUserOwner(userId);
      }

      match /scoutCategories/{scoutCategoryId} {
        allow read, write: if isUserOwner(userId);
      }

      match /scouts/{scoutId} {
        allow read, write: if isUserOwner(userId);
      }

      match /trainingSessions/{sessionId} {
        allow read, write: if isUserOwner(userId);

        match /attendance/{playerId} {
          allow read, write: if isUserOwner(userId);
        }
      }

      match /physicalTests/{testId} {
        allow read, write: if isUserOwner(userId);
      }

      match /{sub}/{docId} {
        allow read, write: if isUserOwner(userId);
      }
    }

    // ═══ /teams/{seasonId} ═════════════════════════════════════════════════

    match /teams/{seasonId} {
      // Creazione e cancellazione SOLO dal server (Admin SDK).
      allow create: if false;
      allow delete: if false;

      // Lettura per membri (owner/staff/legacy sharedWith) e direttori della stagione.
      allow get:  if resource != null &&
                     (isTeamDocMember(resource.data) || isTeamDocDirector(resource.data));
      allow list: if isTeamDocMember(resource.data) || isTeamDocDirector(resource.data);

      // Aggiornamento: solo l'owner può rinominare la stagione (`name`, `updatedAt`).
      allow update: if isTeamDocOwner(resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['name', 'updatedAt']) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasAll(['name', 'updatedAt']) &&
                      request.resource.data.name is string &&
                      request.resource.data.name.size() > 0 &&
                      request.resource.data.name.size() <= 100 &&
                      request.resource.data.updatedAt is string &&
                      request.resource.data.updatedAt.size() > 0 &&
                      request.resource.data.updatedAt.size() <= 64;

      // ─── Rosa (lettura anche al direttore sportivo) ─────────────────────
      match /players/{playerId} {
        allow get, list: if isMemberOrDirector(seasonId);
        allow create, update, delete: if isMember(seasonId);
      }

      // ─── Osservati e categorie (lettura anche al direttore sportivo) ─────
      match /scouts/{scoutId} {
        allow get, list: if isMemberOrDirector(seasonId);
        allow create: if isMember(seasonId) &&
                        'teamOwnerId' in request.resource.data &&
                        request.resource.data.teamOwnerId == request.auth.uid;
        allow update, delete: if isMember(seasonId);
      }

      match /scoutCategories/{categoryId} {
        allow get, list: if isMemberOrDirector(seasonId);
        allow create, update, delete: if isMember(seasonId);
      }

      // ─── Partite (solo membri della stagione) ───────────────────────────
      match /matches/{matchId} {
        allow get, list, create, update, delete: if isMember(seasonId);

        match /lineup/{lineupId} {
          allow get, list, create, update, delete: if isMember(seasonId);
        }

        match /events/{eventId} {
          allow get, list, create, update, delete: if isMember(seasonId);
        }

        match /stats/{statId} {
          allow get, list, create, update, delete: if isMember(seasonId);
        }
      }

      // ─── Allenamenti e presenze (solo membri della stagione) ────────────
      match /sessions/{sessionId} {
        allow get, list, create, update, delete: if isMember(seasonId);

        match /attendance/{playerId} {
          allow get, list, create, update, delete: if isMember(seasonId);
        }
      }

      // ─── Collection legacy / operative di stagione (solo membri) ────────
      match /events/{eventId}        { allow get, list, create, update, delete: if isMember(seasonId); }
      match /trainings/{trainingId}  { allow get, list, create, update, delete: if isMember(seasonId); }
      match /physicalTests/{testId}  { allow get, list, create, update, delete: if isMember(seasonId); }

      // Aggregati precalcolati (profondità variabile)
      match /aggregates/{aggregateId=**} {
        allow get, list, create, update, delete: if isMember(seasonId);
      }

      // ─── Presence: chi è online su questa stagione ──────────────────────
      match /presence/{uid} {
        allow get, list: if isMember(seasonId);
        allow create, update: if isMember(seasonId) &&
                                request.auth.uid == uid &&
                                request.resource.data.keys().hasOnly(['lastSeen']) &&
                                request.resource.data.keys().hasAll(['lastSeen']) &&
                                (request.resource.data.lastSeen is number ||
                                 request.resource.data.lastSeen is timestamp);
        allow delete: if isMember(seasonId);
      }
    }

    // ═══ Collection solo-server ════════════════════════════════════════════

    match /invites/{code=**}    { allow read, write: if false; }
    match /rateLimits/{id=**}   { allow read, write: if false; }
    match /aiUsage/{id=**}      { allow read, write: if false; }
    match /aiCache/{id=**}      { allow read, write: if false; }
    match /feedback/{id=**}     { allow read, write: if false; }

    // ═══ Esercizi ══════════════════════════════════════════════════════════

    match /exercises/{exerciseId} {
      allow get:  if signedIn() && resource != null && (
        ('visibility' in resource.data && resource.data.visibility == 'global') ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      );
      allow list: if signedIn() && (
        ('visibility' in resource.data && resource.data.visibility == 'global') ||
        ('userId' in resource.data && resource.data.userId == request.auth.uid)
      );
      allow create: if signedIn() &&
                      'userId' in request.resource.data &&
                      request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() &&
                      resource != null &&
                      'userId' in resource.data &&
                      resource.data.userId == request.auth.uid &&
                      'userId' in request.resource.data &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() &&
                      resource != null &&
                      'userId' in resource.data &&
                      resource.data.userId == request.auth.uid;
    }

    // ═══ Impostazioni per utente ═══════════════════════════════════════════

    match /settings/{userId} {
      allow read, write: if isUserOwner(userId);
    }

    // ═══ Catch-all ═════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
